[
  {"id": "ddpm2_eq1a", "page": "ddpm_p2", "latex": "p_\\theta(\\mathbf{x}_{0:T}) \\coloneqq p(\\mathbf{x}_T)\\prod_{t=1}^T p_\\theta(\\mathbf{x}_{t-1}|\\mathbf{x}_t)"},
  {"id": "ddpm2_eq1b", "page": "ddpm_p2", "latex": "p_\\theta(\\mathbf{x}_{t-1}|\\mathbf{x}_t) \\coloneqq \\mathcal{N}(\\mathbf{x}_{t-1}; \\boldsymbol{\\mu}_\\theta(\\mathbf{x}_t, t), \\boldsymbol{\\Sigma}_\\theta(\\mathbf{x}_t, t))"},
  {"id": "ddpm2_eq2a", "page": "ddpm_p2", "latex": "q(\\mathbf{x}_{1:T} | \\mathbf{x}_0) \\coloneqq \\prod_{t=1}^T q(\\mathbf{x}_t | \\mathbf{x}_{t-1})"},
  {"id": "ddpm2_eq2b", "page": "ddpm_p2", "latex": "q(\\mathbf{x}_t|\\mathbf{x}_{t-1}) \\coloneqq \\mathcal{N}(\\mathbf{x}_t;\\sqrt{1-\\beta_t}\\mathbf{x}_{t-1},\\beta_t \\mathbf{I})"},
  {"id": "ddpm2_eq3", "page": "ddpm_p2", "latex": "\\mathbb{E}\\left[-\\log p_\\theta(\\mathbf{x}_0)\\right] \\leq \\mathbb{E}_{q}\\left[ - \\log \\frac{p_\\theta(\\mathbf{x}_{0:T})}{q(\\mathbf{x}_{1:T} | \\mathbf{x}_0)}\\right] = \\mathbb{E}_q\\bigg[ -\\log p(\\mathbf{x}_T) - \\sum_{t \\geq 1} \\log \\frac{p_\\theta(\\mathbf{x}_{t-1} | \\mathbf{x}_t)}{q(\\mathbf{x}_t|\\mathbf{x}_{t-1})} \\bigg] \\eqqcolon L"},
  {"id": "ddpm2_eq4", "page": "ddpm_p2", "latex": "q(\\mathbf{x}_t|\\mathbf{x}_0) = \\mathcal{N}(\\mathbf{x}_t; \\sqrt{\\bar\\alpha_t}\\mathbf{x}_0, (1-\\bar\\alpha_t)\\mathbf{I})"},

  {"id": "ddpm3_eq5", "page": "ddpm_p3", "latex": "\\mathbb{E}_q \\bigg[ \\underbrace{D_{\\mathrm{KL}}\\left(q(\\mathbf{x}_T|\\mathbf{x}_0) \\| p(\\mathbf{x}_T)\\right)}_{L_T} + \\sum_{t > 1} \\underbrace{D_{\\mathrm{KL}}\\left(q(\\mathbf{x}_{t-1}|\\mathbf{x}_t,\\mathbf{x}_0) \\| p_\\theta(\\mathbf{x}_{t-1}|\\mathbf{x}_t)\\right)}_{L_{t-1}} \\underbrace{-\\log p_\\theta(\\mathbf{x}_0|\\mathbf{x}_1)}_{L_0} \\bigg]"},
  {"id": "ddpm3_eq6", "page": "ddpm_p3", "latex": "q(\\mathbf{x}_{t-1}|\\mathbf{x}_t,\\mathbf{x}_0) = \\mathcal{N}(\\mathbf{x}_{t-1}; \\tilde{\\boldsymbol{\\mu}}_t(\\mathbf{x}_t, \\mathbf{x}_0), \\tilde\\beta_t \\mathbf{I})"},
  {"id": "ddpm3_eq7a", "page": "ddpm_p3", "latex": "\\tilde{\\boldsymbol{\\mu}}_t(\\mathbf{x}_t, \\mathbf{x}_0) \\coloneqq \\frac{\\sqrt{\\bar\\alpha_{t-1}}\\beta_t }{1-\\bar\\alpha_t}\\mathbf{x}_0 + \\frac{\\sqrt{\\alpha_t}(1- \\bar\\alpha_{t-1})}{1-\\bar\\alpha_t} \\mathbf{x}_t"},
  {"id": "ddpm3_eq7b", "page": "ddpm_p3", "latex": "\\tilde\\beta_t \\coloneqq \\frac{1-\\bar\\alpha_{t-1}}{1-\\bar\\alpha_t}\\beta_t"},
  {"id": "ddpm3_eq8", "page": "ddpm_p3", "latex": "L_{t-1} = \\mathbb{E}_{q}\\left[ \\frac{1}{2\\sigma_t^2} \\|\\tilde{\\boldsymbol{\\mu}}_t(\\mathbf{x}_t,\\mathbf{x}_0) - \\boldsymbol{\\mu}_\\theta(\\mathbf{x}_t, t)\\|^2 \\right] + C"},
  {"id": "ddpm3_eq10", "page": "ddpm_p3", "latex": "\\mathbb{E}_{\\mathbf{x}_0, \\boldsymbol{\\epsilon}}\\left[ \\frac{1}{2\\sigma_t^2} \\left\\| \\frac{1}{\\sqrt{\\alpha_t}}\\left( \\mathbf{x}_t(\\mathbf{x}_0,\\boldsymbol{\\epsilon}) - \\frac{\\beta_t}{\\sqrt{1-\\bar\\alpha_t}}\\boldsymbol{\\epsilon} \\right) - \\boldsymbol{\\mu}_\\theta(\\mathbf{x}_t(\\mathbf{x}_0,\\boldsymbol{\\epsilon}), t) \\right\\|^2 \\right]"},

  {"id": "att4_eq1", "page": "att_p4", "latex": "\\mathrm{Attention}(Q, K, V) = \\mathrm{softmax}(\\frac{QK^T}{\\sqrt{d_k}})V"},
  {"id": "att4_footnote", "page": "att_p4", "latex": "q \\cdot k = \\sum_{i=1}^{d_k} q_ik_i"},

  {"id": "att5_multihead", "page": "att_p5", "latex": "\\mathrm{MultiHead}(Q, K, V) = \\mathrm{Concat}(\\mathrm{head_1}, ..., \\mathrm{head_h})W^O"},
  {"id": "att5_head", "page": "att_p5", "latex": "\\mathrm{head_i} = \\mathrm{Attention}(QW^Q_i, KW^K_i, VW^V_i)"},
  {"id": "att5_wq", "page": "att_p5", "latex": "W^Q_i \\in \\mathbb{R}^{d_{\\text{model}} \\times d_k}"},
  {"id": "att5_wv", "page": "att_p5", "latex": "W^V_i \\in \\mathbb{R}^{d_{\\text{model}} \\times d_v}"},
  {"id": "att5_wo", "page": "att_p5", "latex": "W^O \\in \\mathbb{R}^{hd_v \\times d_{\\text{model}}}"},
  {"id": "att5_dims", "page": "att_p5", "latex": "d_k=d_v=d_{\\text{model}}/h=64"},
  {"id": "att5_ffn", "page": "att_p5", "latex": "\\mathrm{FFN}(x)=\\max(0, xW_1 + b_1) W_2 + b_2"},

  {"id": "per15_var1", "page": "per_p15", "latex": "\\int_{\\tau_1}^{\\tau_2}{\\sqrt{\\tau}(<Y,\\nabla R>+2<\\nabla_Y X,X>)d\\tau}"},
  {"id": "per15_var2", "page": "per_p15", "latex": "\\int_{\\tau_1}^{\\tau_2}{\\sqrt{\\tau}(<Y,\\nabla R>+2\\frac{d}{d\\tau}<Y,X>-2<Y,\\nabla_X X>-4\\mathrm{Ric}(Y,X))d\\tau}"},
  {"id": "per15_eq71", "page": "per_p15", "latex": "=\\left.2\\sqrt{\\tau}<X,Y>\\right|_{\\tau_1}^{\\tau_2}+\\int_{\\tau_1}^{\\tau_2}{\\sqrt{\\tau}<Y,\\nabla R-2\\nabla_X X-4\\mathrm{Ric}(X,\\cdot)-\\frac{1}{\\tau}X>d\\tau}"},
  {"id": "per15_eq72", "page": "per_p15", "latex": "\\nabla_X X-\\frac{1}{2}\\nabla R+\\frac{1}{2\\tau}X+2\\mathrm{Ric}(X,\\cdot)=0"},
  {"id": "per15_gradL", "page": "per_p15", "latex": "|\\nabla L|^2=4\\bar{\\tau}|X|^2=-4\\bar{\\tau}R+4\\bar{\\tau}(R+|X|^2)"},
  {"id": "per15_Ltau", "page": "per_p15", "latex": "L_{\\bar{\\tau}}(q,\\bar{\\tau})=\\sqrt{\\bar{\\tau}}(R+|X|^2)-<X,\\nabla L>=2\\sqrt{\\bar{\\tau}}R-\\sqrt{\\bar{\\tau}}(R+|X|^2)"},
  {"id": "per15_ddtau", "page": "per_p15", "latex": "\\frac{d}{d\\tau}(R(\\gamma(\\tau))+|X(\\tau)|^2)=R_{\\tau}+<\\nabla R,X>+2<\\nabla_X X,X>+2\\mathrm{Ric}(X,X)"},
  {"id": "per15_eq73", "page": "per_p15", "latex": "=-H(X)-\\frac{1}{\\tau}(R+|X|^2)"},

  {"id": "per16_eq74", "page": "per_p16", "latex": "\\bar{\\tau}^{\\frac{3}{2}}(R+|X|^2)(\\bar{\\tau})=-K+\\frac{1}{2}L(q,\\bar{\\tau})"},
  {"id": "per16_K", "page": "per_p16", "latex": "K=K(\\gamma,\\bar{\\tau})"},
  {"id": "per16_Kint", "page": "per_p16", "latex": "\\int_0^{\\bar{\\tau}}{\\tau^{\\frac{3}{2}}H(X)d\\tau}"},
  {"id": "per16_eq75", "page": "per_p16", "latex": "L_{\\bar{\\tau}}=2\\sqrt{\\bar{\\tau}}R-\\frac{1}{2\\bar{\\tau}}L+\\frac{1}{\\bar{\\tau}}K"},
  {"id": "per16_eq76", "page": "per_p16", "latex": "|\\nabla L|^2=-4\\bar{\\tau}R+\\frac{2}{\\sqrt{\\bar{\\tau}}}L-\\frac{4}{\\sqrt{\\bar{\\tau}}}K"},
  {"id": "per16_var2", "page": "per_p16", "latex": "\\delta^2_Y(\\mathcal{L})=\\int_0^{\\bar{\\tau}}{\\sqrt{\\tau}(Y\\cdot Y\\cdot R+2<\\nabla_Y \\nabla_Y X,X>+2|\\nabla_Y X|^2)d\\tau}"},
  {"id": "per16_eq78", "page": "per_p16", "latex": "\\nabla_X Y=-\\mathrm{Ric}(Y,\\cdot)+\\frac{1}{2\\tau}Y"}
]
